# служебные данные Playwright (снапшоты страниц, консоль-логи браузера)
.playwright/
.playwright-cli/

# автогенерируется самой утилитой playwright-cli (playwright-cli install --skills) — версия
# документации меняется вместе с версией самого playwright-cli на конкретной машине, это не
# логика агента, поддерживать в репозитории смысла нет
.claude/skills/playwright-cli/

# личный конфиг Claude Code для MCP-серверов конкретной машины (например, Figma MCP,
# см. Readme.md шаг 7) — создаётся командой `claude mcp add`, не для репозитория
.mcp.json

# служебные маркеры сабмитов форм для координации параллельных агентов (см. form-submit-checks) — только на время одного прогона
.form-submissions/

# отчёты и логи прогонов агента (report.txt — старое расширение до перехода на .md)
report.md
report.txt
*.log

# системные файлы ОС
.DS_Store
Thumbs.db

# файлы с секретами (на случай, если появятся API-ключи и т.п.)
.env
*.env

# скриншоты багов (в рабочей папке каждого сайта — {домен}/screenshots/)
*.png

# снапшоты страниц Playwright (yml/yaml)
*.yaml
*.yml

# входной файл с реальными данными клиентов (URL, номера, комментарии) — не для репозитория
Сайты.txt

# локальные результаты прогонов eval-фикстуры (см. eval/README.md) — не для репозитория
eval/last-run-report*.txt
