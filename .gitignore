# временные папки Playwright (снапшоты, консоль-логи)
.playwright/
.playwright-cli/

# отчёты
report.txt
*.log
*.json
!package.json

# системные файлы
.DS_Store
Thumbs.db

# файлы с секретами
.env
*.env

# Изображения (скриншоты багов, иконки и т.п.) — папку screenshots/ сохраняем пустой в репо
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.svg
*.webp
!screenshots/.gitkeep

# YAML-файлы (снапшоты, конфиги, если они не нужны в репозитории)
*.yaml
*.yml

# НО не игнорировать файлы GitHub Actions (они нужны для CI/CD)
!.github/workflows/*.yml